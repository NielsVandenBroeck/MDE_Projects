class Hero {
    string name;
    int heroLevel;
    int health;
    contains Race race;
    contains Role role;
    contains Attribute[1..*] attributes;
    contains Armor armor;
    contains Weapon weapon;
    contains Potion[] inventory;
    contains Skill[] skills;
}

abstract class Race {
    string raceName;
}
class Human extends Race.
class Elf extends Race.
class Orc extends Race.
class Dwarf extends Race.
raceName(Human::new): "Human".
raceName(Elf::new): "Elf".
raceName(Orc::new): "Orc".
raceName(Dwarf::new): "Dwarf".

abstract class Role {
    string roleName;
}
class Wizard extends Role.
class Archer extends Role.
class Thief extends Role.
class Knight extends Role.
roleName(Wizard::new): "Wizard".
roleName(Archer::new): "Archer".
roleName(Thief::new): "Thief".
roleName(Knight::new): "Knight".

abstract class Attribute {
    string attributeName;
    int attributeLevel;
}
class Strength extends Attribute.
class Intelligence extends Attribute.
class Agility extends Attribute.
class Perception extends Attribute.
attributeName(Strength::new): "Strength".
attributeName(Intelligence::new): "Intelligence".
attributeName(Agility::new): "Agility".
attributeName(Perception::new): "Perception".

abstract class Skill {
    string skillName;
    int requiredHeroLevel;
    Attribute requiredAttribute;
    int requiredAttributeLevel;
}
class Fireball extends Skill.
skillName(Fireball::new): "Fireball".

abstract class Item {
    string type;
}
abstract class Armor extends Item {
    int defense;
}
class LightArmor extends Armor.
class HeavyArmor extends Armor.
type(LightArmor::new): "LightArmor".
type(HeavyArmor::new): "HeavyArmor".

abstract class Weapon extends Item {
    int damage;
}
class Sword extends Weapon.
class Bow extends Weapon.
class Dagger extends Weapon.
class Wand extends Weapon.
type(Sword::new): "Sword".
type(Bow::new): "Bow".
type(Dagger::new): "Dagger".
type(Wand::new): "Wand".

abstract class Potion extends Item {
    int amount;
}
class HealthRegen extends Potion.
class Poison extends Potion.
type(HealthRegen::new): "HealthRegen".
type(Poison::new): "Poison".

% CONSTRAINTS

scope Hero = 1.
scope Race = 1.
scope Role = 1.

scope Armor = 1.
scope Weapon = 1.

scope Strength = 0..1.
scope Intelligence = 0..1.
scope Agility = 0..1.
scope Perception = 0..1.

scope Fireball = 0..1.

error invalidHeroLevel(Hero h) <->
    heroLevel(h) < 0 || heroLevel(h) > 100.
error invalidHealth(Hero h) <-> 
    health(h) < 0 || health(h) > 100.
error invalidAttributeLevel(Attribute a) <->
    attributeLevel(a) < 0 || attributeLevel(a) > 100.
error invalidRequiredHeroLevel(Skill s) <->
    requiredHeroLevel(s) < 0 || requiredHeroLevel(s) > 100.
error invalidRequiredAttribute(Hero h) <->
    skills(h, s),
    heroLevel(h) >= requiredHeroLevel(s).
error invalidInventory(Hero h) <->
    count {inventory(h, _i)} > 10.
error invalidAttribute(Attribute a) <->
    attributeLevel(a) > 0.
error onlyWizardWand1() <->
    Wand(_w), !Wizard(_w).
error onlyWizardWand2() <->
    !Wand(_w), Wizard(_w).
error thiefNoHeavyArmor() <->
    Thief(_t), HeavyArmor(_hh).
