hero:RAM_Hero

heroState:RAM_CreatureState {
    RAM_moved = `get_value(this) == False`;
}
isHeroState:RAM_CreatureState_ass (hero -> heroState)

standingTile:RAM_Tile
standardTile:RAM_StandardTile

isStandingTile:RAM_StandingTile (hero -> standingTile)
areAdjacent:RAM_AdjacentTile (standingTile -> standardTile)