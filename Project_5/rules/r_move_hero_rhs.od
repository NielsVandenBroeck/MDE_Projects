hero:RAM_Hero

heroState:RAM_CreatureState {
    RAM_moved = `True`;
}
:RAM_CreatureState_ass (hero -> heroState)

standingTile:RAM_Tile

tile:RAM_Tile

# Move to new tile
:RAM_StandingTile (hero -> tile)

# Check target tile's effects.
:GlobalCondition {
    condition = ```
        # Get hero tile
        hero = get_all_instances("Hero")[0][1]
        assoc = (get_outgoing(hero, "StandingTile")[0])
        heroTile = get_target(assoc)

        # If trap tile, lose a life
        if get_type_name(heroTile) == "Trap":
            set_slot_value(hero, "lives", get_slot_value(hero, "lives") - 1)

        # Pick up items
        item_assocs = get_outgoing(heroTile, "StandardTileItem")
        for item_assoc in item_assocs:
            item = get_target(item_assoc)
            # Add item to inventory
            create_link(link_name=f"item_{get_name(item)}", assoc_name="HeroInventory", src=hero, tgt=item)
            # Add points to WorldState
            if get_type_name(item) == "Objective":
                points = get_slot_value(item, "points")
                worldstate = get_all_instances("WorldState")[0][1]
                set_slot_value(worldstate, "collectedPoints", get_slot_value(worldstate, "collectedPoints") + points)
            # Remove link to tile
            delete(item_assoc)
    ```;
}
