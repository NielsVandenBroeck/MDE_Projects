hero:RAM_Hero {
    RAM_lives = `get_value(this)`;
}

monster:RAM_Monster {
    RAM_lives = `get_value(this)`;
    condition = `get_slot_value(this, "lives") < get_slot_value(matched("hero"), "lives")`;
}

monsterState:RAM_CreatureState {
    RAM_fought = `get_value(this) == False`;
}
isMonsterState:RAM_CreatureState_ass (monster -> monsterState)

tile:RAM_Tile

heroTile:RAM_StandingTile (hero -> tile)
monsterTile:RAM_StandingTile (monster -> tile)