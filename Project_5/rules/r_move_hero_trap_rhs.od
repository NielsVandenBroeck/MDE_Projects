hero:RAM_Hero {
    RAM_lives = `get_value(this) - 1`;
}

heroState:RAM_CreatureState {
    RAM_moved = `True`;
}
isHeroState:RAM_CreatureState_ass (hero -> heroState)

standingTile:RAM_Tile
trap:RAM_Trap

newStandingTile:RAM_StandingTile (hero -> trap)
areAdjacent:RAM_AdjacentTile (standingTile -> trap)