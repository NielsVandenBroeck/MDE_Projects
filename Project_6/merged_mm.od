:Inheritance (Obstacle -> Tile)
PNPlaceState_numTokens:AttributeLink (PNPlaceState -> Integer) {
    name = "numTokens";
    optional = False;
    constraint = `"numTokens cannot be negative" if get_value(get_target(this)) < 0 else None`;
}
