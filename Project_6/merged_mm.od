# Auto generated topified runtime Meta-Model, merged RPG and Petri Nets
State:Class {
    abstract = True;
}
CreatureState:Class
Trap:Class
Level:Class {
    constraint = ```
        conform = True
        
        # Name cannot be empty
        if len(get_value(get_slot(this, "name"))) == 0: conform = False
        conform
    ```;
}
Hero:Class {
    lower_cardinality = 1;
    upper_cardinality = 1;
}
PNPlaceState:Class
World:Class {
    upper_cardinality = 1;
    constraint = ```
        conform = True;
        
        ### Objectives cannot sum to more than 100 total ###
        objectives = get_all_instances("Objective")
        sum = 0
        for objective in objectives:
            sum += get_value(get_slot(objective[1], "points"))
        if sum > 100: conform = False
        
        conform
    ```;
    lower_cardinality = 1;
}
Monster:Class
PNPlace:Class
Top:Class {
    abstract = True;
}
Obstacle:Class
Door:Class
Item:Class
Creature:Class {
    constraint = ```
        conform = True
        
        # Lives cannot be negative
        if get_value(get_slot(this, "lives")) < 0: conform = False
        
        conform
    ```;
    abstract = True;
}
Clock:Class
WorldState:Class
PNTransition:Class
Key:Class
PNConnectable:Class {
    abstract = True;
}
Objective:Class {
    constraint = ```
        conform = True
        
        # Points cannot be negative
        if get_value(get_slot(this, "points")) < 0: conform = False
        
        conform
    ```;
}
StandardTile:Class
Tile:Class {
    abstract = True;
}
