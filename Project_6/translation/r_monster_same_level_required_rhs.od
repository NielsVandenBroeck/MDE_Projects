tile1:RAM_Tile
level:RAM_Level

isTile1Inlevel:RAM_LevelTiles (level -> tile1)

levelPlace:RAM_PNPlace {
    condition = `get_name(this) == f"level_place_{get_name(matched('level'))}"`;
}

monsterTransition:RAM_PNTransition {
    condition = `f"move_monster_{get_name(matched('tile1'))}" in get_name(this)`;
}

# Arcs between level and neighbor transition for monster
moveMonsterRequired1:RAM_arc (levelPlace -> monsterTransition) {
    name = `f"monster_move_required_from_{get_name(matched('tile1'))}_1"`;
}
moveMonsterRequired2:RAM_arc (monsterTransition -> levelPlace) {
    name = `f"monster_move_required_from_{get_name(matched('tile1'))}_2"`;
}

# Generic Link For NAC
adjacencyMonsterAlreadyLevel:RAM_generic_link (level -> monsterTransition)
