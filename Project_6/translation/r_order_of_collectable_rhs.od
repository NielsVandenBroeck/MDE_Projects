collectableTransition:RAM_PNTransition {
    condition = `"pick_up_" in get_name(this)`;
}

# Get the order places so we can add arcs in rhs
collectablePlace:RAM_PNPlace {
    condition = `get_name(this) == f"Collected_place"`;
}
monsterMovedPlace:RAM_PNPlace {
    condition = `get_name(this) == f"Monster_moved_place"`;
}

# Add arcs
collectedTransition1:RAM_arc (collectablePlace -> collectableTransition) {
    name = `f"transition_collected_{get_name(matched('collectableTransition'))}_1"`;
}
collectedTransition2:RAM_arc (collectableTransition -> monsterMovedPlace) {
    name = `f"transition_collected_{get_name(matched('collectableTransition'))}_2"`;
}