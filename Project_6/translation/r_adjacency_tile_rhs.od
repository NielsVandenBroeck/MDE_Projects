tile1:RAM_Tile
tile2:RAM_Tile
heroPlace1:RAM_PNPlace {
    condition = `get_name(this) == f"hero_place_{get_name(matched('tile1'))}"`;
}
heroPlace2:RAM_PNPlace {
    condition = `get_name(this) == f"hero_place_{get_name(matched('tile2'))}"`;
}
monsterPlace1:RAM_PNPlace {
    condition = `get_name(this) == f"monster_place_{get_name(matched('tile1'))}"`;
}
monsterPlace2:RAM_PNPlace {
    condition = `get_name(this) == f"monster_place_{get_name(matched('tile2'))}"`;
}

# Adjacency
isAdjacentForwards:RAM_AdjacentTile (tile1 -> tile2)

# Place From Tile
isHeroPlaceOf1:RAM_generic_link (tile1 -> heroPlace1)
isHeroPlaceOf2:RAM_generic_link (tile2 -> heroPlace2)
isMonsterPlaceOf1:RAM_generic_link (tile1 -> monsterPlace1)
isMonsterPlaceOf2:RAM_generic_link (tile2 -> monsterPlace2)

# Create Transitions
heroTransition:RAM_PNTransition {
    name = `f"move_hero_{get_name(matched('tile1'))}_to_{get_name(matched('tile2'))}"`;
}
monsterTransition:RAM_PNTransition {
    name = `f"move_monster_{get_name(matched('tile1'))}_to_{get_name(matched('tile2'))}"`;
}

# Create Arcs
heroTransitionBeginArc:RAM_arc (heroPlace1 -> heroTransition) {
    name = `f"hero_{get_name(matched('tile1'))}_to1_{get_name(matched('tile2'))}"`;
}
heroTransitionEndArc:RAM_arc (heroTransition -> heroPlace2) {
    name = `f"hero_{get_name(matched('tile1'))}_to2_{get_name(matched('tile2'))}"`;
}

monsterTransitionBeginArc:RAM_arc (monsterPlace1 -> monsterTransition) {
    name = `f"monster_{get_name(matched('tile1'))}_to1_{get_name(matched('tile2'))}"`;
}
monsterTransitionEndArc:RAM_arc (monsterTransition -> monsterPlace2) {
    name = `f"monster_{get_name(matched('tile1'))}_to2_{get_name(matched('tile2'))}"`;
}

# Generic Link For NAC
tileToTile1:RAM_generic_link (tile1 -> tile2)
