tile1:RAM_Tile
tile2:RAM_Tile
tile1HeroPlace:RAM_PNPlace
tile2HeroPlace:RAM_PNPlace
tile1MonsterPlace:RAM_PNPlace
tile2MonsterPlace:RAM_PNPlace

# Adjacent
areAdjacent1:RAM_AdjacentTile (tile1->tile2)
areAdjacent2:RAM_AdjacentTile (tile2->tile1)

# Places From The Tiles
isHeroPlaceOf1:RAM_generic_link(tile1->tile1HeroPlace)
isHeroPlaceOf2:RAM_generic_link(tile2->tile2HeroPlace)
isMonsterPlaceOf1:RAM_generic_link(tile1->tile1MonsterPlace)
isMonsterPlaceOf2:RAM_generic_link(tile2->tile2MonsterPlace)

# Make transitions
tileHeroTransition1:RAM_PNTransition
tileHeroTransition2:RAM_PNTransition
tileMonsterTransition1:RAM_PNTransition
tileMonsterTransition2:RAM_PNTransition

# Connect Left side of transitions
tileHeroLeftArc1:RAM_arc (tile1HeroPlace->tileHeroTransition1)
tileHeroLeftArc2:RAM_arc (tile2HeroPlace->tileHeroTransition2)
tileMonsterLeftArc1:RAM_arc (tile1MonsterPlace->tileMonsterTransition1)
tileMonsterLeftArc2:RAM_arc (tile1MonsterPlace->tileMonsterTransition2)

# Connect right side of transitions
tileHeroRightArc1:RAM_arc (tileHeroTransition1->tile1HeroPlace)
tileHeroRightArc2:RAM_arc (tileHeroTransition2->tile2HeroPlace)
tileMonsterRightArc1:RAM_arc (tileMonsterTransition1->tile1MonsterPlace)
tileMonsterRightArc2:RAM_arc (tileMonsterTransition2->tile1MonsterPlace)


# For NAC
adjacencyTile1:RAM_generic_link (tile1->tile2)
adjacencyTile2:RAM_generic_link (tile2->tile1)
