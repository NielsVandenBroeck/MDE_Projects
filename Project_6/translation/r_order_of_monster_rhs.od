monsterTransition:RAM_PNTransition {
    condition = `"move_monster_" in get_name(this)`;
}

# Get the order places so we can add arcs in rhs
monsterPlace:RAM_PNPlace {
    condition = `get_name(this) == f"Monster_moved_place"`;
}
heroPlace:RAM_PNPlace {
    condition = `get_name(this) == f"Hero_moved_place"`;
}

# Add arcs
monsterMovedTransition1:RAM_arc (monsterPlace -> monsterTransition) {
    name = `f"transition_monster_moved_{get_name(matched('monsterTransition'))}_1"`;
}
monsterMovedTransition2:RAM_arc (monsterTransition -> heroPlace) {
    name = `f"transition_monster_moved_{get_name(matched('monsterTransition'))}_2"`;
}