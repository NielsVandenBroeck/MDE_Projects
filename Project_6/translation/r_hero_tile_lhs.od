hero:RAM_Hero
standingTile:RAM_Tile

isStandingTile:RAM_StandingTile (hero -> standingTile)

tileHeroPlace:RAM_PNPlace
tileToPNPLink:RAM_generic_link(standingTile->tileHeroPlace)

tileHeroPlaceState:RAM_PNPlaceState {
    RAM_numTokens = `get_value(this) == 0`;
}
heroStateToHero:RAM_pn_of (tileHeroPlaceState -> tileHeroPlace)
