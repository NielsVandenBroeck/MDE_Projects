tile:RAM_Tile

# Create All Places
heroPlace:RAM_PNPlace {
    name = `f"hero_place_{get_name(matched('tile'))}"`;
}
monsterPlace:RAM_PNPlace {
    name = `f"monster_place_{get_name(matched('tile'))}"`;
}
objectivePlace:RAM_PNPlace {
    name = `f"objective_place_{get_name(matched('tile'))}"`;
}
keyPlace:RAM_PNPlace {
    name = `f"key_place_{get_name(matched('tile'))}"`;
}

# Create Place States
heroPlaceState:RAM_PNPlaceState {
    name = `f"hero_place_state_{get_name(matched('tile'))}"`;
    RAM_numTokens = `0`;
}
monsterPlaceState:RAM_PNPlaceState {
    name = `f"monster_place_state_{get_name(matched('tile'))}"`;
    RAM_numTokens = `0`;
}
objectivePlaceState:RAM_PNPlaceState {
    name = `f"objective_place_state_{get_name(matched('tile'))}"`;
    RAM_numTokens = `0`;
}
keyPlaceState:RAM_PNPlaceState {
    name = `f"key_place_state_{get_name(matched('tile'))}"`;
    RAM_numTokens = `0`;
}

# Link Place State To Place
HeroStateToHeroPlace:RAM_pn_of (heroPlaceState -> heroPlace) {
    name = `f"link_hero_state_{get_name(matched('tile'))}"`;
}
MonsterStateToMonsterPlace:RAM_pn_of (monsterPlaceState -> monsterPlace) {
    name = `f"link_monster_state_{get_name(matched('tile'))}"`;
}
ObjectiveStateToObjectivePlace:RAM_pn_of (objectivePlaceState -> objectivePlace) {
    name = `f"link_objective_state_{get_name(matched('tile'))}"`;
}
KeyStateToKeyPlace:RAM_pn_of (keyPlaceState -> keyPlace) {
    name = `f"link_key_state_{get_name(matched('tile'))}"`;
}

# Generic Link For Adjacency Rule
tileToHeroPlace:RAM_generic_link (tile -> heroPlace)
tileToMonsterPlace:RAM_generic_link (tile -> monsterPlace)

# Generic Link For NAC
tileToSelf:RAM_generic_link (tile -> tile)
