hero:RAM_Hero
heroTile:RAM_Tile
heroPlace:RAM_PNPlace

# Change amount of tokens
heroPlaceState:RAM_PNPlaceState {
    RAM_numTokens = `get_value(this) + 1`;
}

# Is Place State
isPlaceState:RAM_pn_of (heroPlaceState -> heroPlace)

# Standing Tile and Place
isStandingTile:RAM_StandingTile (hero -> heroTile)
isTilePlace:RAM_generic_link (heroTile -> heroPlace)

# Link Hero and Hero Place for NAC
isHeroPlace:RAM_generic_link (hero -> heroPlace)
